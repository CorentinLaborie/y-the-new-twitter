# Copy to .env for local development. Never commit .env.
# Values are placeholders: generate every secret locally (for example: openssl rand -hex 32).

# Profile: local, staging or production
NODE_ENV=local

# PostgreSQL. Application account (DEC-059, DEC-065). The password matches docker-compose.yml (local only)
DATABASE_URL=postgresql://y:y-local-only@localhost:5434/y
# PostgreSQL maintenance account, used only by the purges (DEC-059, DEC-065)
DATABASE_MAINTENANCE_URL=postgresql://y_maintenance:CHANGE_ME@localhost:5434/y

# Secrets (no values here)
AUDIT_HMAC_KEY=
IP_HASH_KEY=
BACKUP_CODE_HMAC_KEY=
SESSION_SECRET=

# E-mail (DEC-018). Brevo is on hold (DEC-110): leave empty until it is set up
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
ADMIN_ALERT_EMAIL=

# Age verification (DEC-019, DEC-020)
VERIFAGE_BASE_URL=
VERIFAGE_API_KEY=

# Public URL of the frontend (links in e-mails, CORS)
APP_PUBLIC_URL=http://localhost:3000

# Product rules
Y_CONVERSATION_THRESHOLD=50
Y_CODE_TTL_MINUTES=15
